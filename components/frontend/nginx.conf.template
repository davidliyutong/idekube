server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # DNS resolver (use Docker's DNS or override with RESOLVER env var)
    resolver ${RESOLVER} valid=30s;

    # Set backend URL as variable to enable dynamic DNS resolution
    set $backend_url "${BACKEND_HOST}:${BACKEND_PORT}";

    location / {
        try_files $uri $uri/ /index.html;
    }

    # API proxy - backend URL configured via environment variables
    location /api {
        proxy_pass http://$backend_url;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    # WebSocket proxy - backend URL configured via environment variables
    location /ws {
        proxy_pass http://$backend_url;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
    }

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 10240;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml+rss application/json;
    gzip_disable "MSIE [1-6]\.";
}
