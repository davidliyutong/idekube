# Server Configuration
SERVER_ADDRESS=:8080

# JWT Configuration
JWT_SECRET=change-me-in-production-use-a-strong-secret
JWT_EXPIRATION_HOURS=24

# Admin Account Configuration
# If set, an admin account will be created automatically on first startup
# IMPORTANT: Change this password after first login!
ADMIN_PASSWORD=admin123

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=idekube
POSTGRES_PASSWORD=idekube123
POSTGRES_DB=idekube

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# RBAC Service Configuration
RBAC_ENDPOINT=http://localhost:8081

# Kubernetes Configuration
KUBECONFIG=/path/to/your/kubeconfig
NAMESPACE=idekube

# Logging
LOG_LEVEL=debug
WORKER_THREADS=4
