# Server Configuration
SERVER_ADDRESS=:8080

# JWT Configuration
JWT_SECRET=change-me-in-production-use-a-strong-secret

# Admin Account Configuration
# If set, an admin account will be created automatically on first startup
# IMPORTANT: Change this password after first login!
ADMIN_PASSWORD=admin123

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=idekube
POSTGRES_PASSWORD=idekube
POSTGRES_DB=idekube

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# OPA Configuration
OPA_POLICY_PATH=configs/policy.rego
OPA_DATA_PATH=configs/data.json

# Kubernetes Configuration
KUBECONFIG=/path/to/your/kubeconfig
NAMESPACE=idekube

# Logging
LOG_LEVEL=debug
WORKER_THREADS=4
