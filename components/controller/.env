# Server Configuration
SERVER_ADDRESS=:8080

# JWT Configuration
JWT_SECRET=change-me-in-production-use-a-strong-secret

# Admin Account Configuration
# If set, an admin account will be created automatically on first startup
# IMPORTANT: Change this password after first login!
ADMIN_PASSWORD=admin123

# Registration Configuration
# Set to false to disable user registration
ENABLE_REGISTRATION=false

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=idekube
POSTGRES_PASSWORD=idekube
POSTGRES_DB=idekube

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# OPA Configuration
OPA_POLICY_PATH=configs/policy.rego
OPA_DATA_PATH=configs/data.json

# Kubernetes Configuration
KUBECONFIG=/path/to/your/kubeconfig
NAMESPACE=idekube

# SMTP Configuration (for email notifications)
# Leave empty to disable email features
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@idekube.io
SMTP_FROM_NAME=IDEKube

# Base URL for email links (password reset, email verification, etc.)
BASE_URL=http://localhost:8080

# Logging
LOG_LEVEL=info
WORKER_THREADS=4
